# Server-only: Next BFF (app/api/*) proxies to Express with this URL.
BACKEND_URL=http://localhost:5000

# Public: absolute URLs for article/avatar images when the API returns relative paths.
NEXT_PUBLIC_API_URL=http://localhost:5000

# Public: base URL of this Next app (used by some RSC fetches to local /api routes).
NEXT_PUBLIC_BASE_URL=http://localhost:3000
